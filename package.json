{
  "name": "glozanet",
  "version": "2.0.0",
  "desktopName": "GlozaNet",
  "author": "GlozaLabs",
  "homepage": "https://github.com/Gloza-Labs/GlozaNet",
  "description": "The official Gloza browser.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist-mac-intel": "electron-builder --mac --x64",
    "dist-mac-arm": "electron-builder --mac --arm64",
    "dist-mac-all": "electron-builder --mac --x64 --arm64",
    "dist-win": "electron-builder --win",
    "dist-deb": "electron-builder --linux"
  },
  "build": {
    "appId": "com.glozalabs.glozanet",
    "productName": "GlozaNet",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/dmgIcon.icns",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": ["deb"],
      "category": "Network",
      "maintainer": "Matej Pina",
      "vendor": "GlozaLabs",
      "description": "The official Gloza browser.",
      "synopsis": "The official Gloza browser.",
      "executableName": "gloza-net",
      "icon": "assets/icons"
    },
    "deb": {
      "packageCategory": "net",
      "priority": "optional",
      "depends": [
        "gconf-service",
        "libasound2",
        "libatk1.0-0",
        "libc6",
        "libcairo2",
        "libcups2",
        "libdbus-1-3",
        "libexpat1",
        "libfontconfig1",
        "libgcc1",
        "libgconf-2-4",
        "libgdk-pixbuf2.0-0",
        "libglib2.0-0",
        "libgtk-3-0",
        "libnspr4",
        "libpango-1.0-0",
        "libpangocairo-1.0-0",
        "libstdc++6",
        "libx11-6",
        "libx11-xcb1",
        "libxcb1",
        "libxcomposite1",
        "libxcursor1",
        "libxdamage1",
        "libext6",
        "libxfixes3",
        "libxi6",
        "libxrandr2",
        "librender1",
        "libxss1",
        "libxtst6",
        "ca-certificates",
        "fonts-liberation",
        "libappindicator3-1",
        "libnss3",
        "lsb-release",
        "xdg-utils"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "GlozaNet",
      "license": "assets/license.txt"
    },
    "dmg": {
      "title": "Install GlozaNet 2.0.0",
      "icon": "assets/dmgIcon.icns",
      "background": "assets/bg.png",
      "window": {
        "width": 540,
        "height": 380,
        "x": 400,
        "y": 200
      },
      "iconSize": 128,
      "contents": [
        {
          "x": 130,
          "y": 200,
          "type": "file"
        },
        {
          "x": 410,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "license": "MIT",
  "dependencies": {
    "@ghostery/adblocker": "^2.5.2",
    "@ghostery/adblocker-electron": "^2.5.2"
  },
  "devDependencies": {
    "builder": "^1.0.4",
    "electron": "^43.8.0",
    "electron-builder": "^26.5.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
